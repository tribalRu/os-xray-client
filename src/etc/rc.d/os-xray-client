#!/bin/sh
#
# PROVIDE: os_xray_client
# REQUIRE: LOGIN NETWORKING
# KEYWORD: shutdown

. /etc/rc.subr

name="xrayclient"
rcvar="xrayclient_enable"

load_rc_config $name

: ${xrayclient_enable:="YES"}
: ${xrayclient_config:="/usr/local/etc/xray/config.json"}
: ${xrayclient_bin:="/usr/local/bin/xray"}
: ${xrayclient_asset_dir:="/usr/local/share/xray"}

pidfile="/var/run/${name}.pid"
command="/usr/sbin/daemon"
command_args="-c -f -P ${pidfile} -r ${xrayclient_bin} run -c ${xrayclient_config}"

start_precmd="xrayclient_prestart"
stop_postcmd="xrayclient_poststop"
status_cmd="xrayclient_status"

xrayclient_pid_is_ours()
{
    _pid="$1"
    [ -n "${_pid}" ] || return 1
    kill -0 "${_pid}" 2>/dev/null || return 1
    # Defend against recycled PIDs: the pidfile carries the daemon
    # supervisor PID, whose command looks like
    # "daemon: /usr/local/bin/xray[<child>] (daemon)" — it always contains
    # "xray" (and so would an xray child, should the pidfile be rewritten).
    _cmd=$(ps -p "${_pid}" -o command= 2>/dev/null)
    case "${_cmd}" in
        *xray*) return 0 ;;
    esac
    return 1
}

xrayclient_prestart()
{
    install -d -m 0755 /var/log/xray
    install -d -m 0755 /usr/local/etc/xray
    install -d -m 0755 "${xrayclient_asset_dir}"
    touch /var/log/xray/access.log /var/log/xray/error.log

    export XRAY_LOCATION_ASSET="${xrayclient_asset_dir}"

    if [ ! -x "${xrayclient_bin}" ]; then
        echo "Error: ${xrayclient_bin} not found or not executable. Please download Xray-core in the Maintenance tab."
        return 1
    fi

    # Respect the GUI "Enable Xray Client" toggle (the rc.conf flag alone
    # cannot reflect it). Read general.enabled from /conf/config.xml.
    XRAY_ENABLED=$(/usr/local/bin/python3 - << 'EOF' 2>/dev/null || echo ""
import sys
import xml.etree.ElementTree as ET
try:
    root = ET.parse("/conf/config.xml").getroot()
    val = root.findtext(".//OPNsense/XrayClient/general/enabled")
    print("enabled" if (val or "").strip() == "1" else "disabled")
except Exception:
    print("enabled")
EOF
    )
    if [ "${XRAY_ENABLED}" = "disabled" ]; then
        echo "Xray Client is disabled in the GUI (General > Enable Xray Client). Skipping start."
        return 1
    fi

    # Fail fast on an invalid generated config instead of crash-looping
    # under `daemon -r`. `xray run -test` exits 0 only for a valid config.
    if [ ! -f "${xrayclient_config}" ]; then
        echo "Error: Xray config not found at ${xrayclient_config}. Run 'configctl template reload OPNsense/XrayClient' or Apply settings."
        return 1
    fi
    if ! "${xrayclient_bin}" run -test -c "${xrayclient_config}" >/dev/null 2>&1; then
        echo "Error: Xray config test failed for ${xrayclient_config}. See /var/log/xray/error.log."
        return 1
    fi

    # Kill stray Xray instances (e.g. after a crashed/killed supervisor
    # left the child behind) before starting a new one.
    pkill -f "${xrayclient_bin} run -c ${xrayclient_config}" 2>/dev/null || true

    # Reconcile a stale TUN interface (created by the old plugin version or
    # leaked by a crashed Xray). Xray creates the interface itself on start.
    /usr/local/opnsense/scripts/OPNsense/XrayClient/setup_tun.sh up
}

xrayclient_poststop()
{
    # Remove any leftover TUN interface (best effort; Xray destroys its
    # own interface on a clean shutdown).
    /usr/local/opnsense/scripts/OPNsense/XrayClient/setup_tun.sh down || true
    # Best effort: kill a leaked Xray child if the supervisor died first.
    pkill -f "${xrayclient_bin} run -c ${xrayclient_config}" 2>/dev/null || true
    rm -f "${pidfile}"
}

xrayclient_status()
{
    if [ -f "${pidfile}" ]; then
        pid=$(cat "${pidfile}" 2>/dev/null)
        if xrayclient_pid_is_ours "${pid}"; then
            echo "xrayclient is running as pid ${pid}."
            return 0
        fi
    fi
    echo "xrayclient is not running."
    return 1
}

run_rc_command "$1"
