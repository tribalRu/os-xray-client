{%- if v != '' -%}{%- do q.append('"maxStreamReceiveWindow": ' ~ (v | int)) -%}{%- endif -%}
{%- set v = node.fm_quic_init_conn_window | default('') | string | trim -%}
{%- if v != '' -%}{%- do q.append('"initConnectionReceiveWindow": ' ~ (v | int)) -%}{%- endif -%}
{%- set v = node.fm_quic_max_conn_window | default('') | string | trim -%}
{%- if v != '' -%}{%- do q.append('"maxConnectionReceiveWindow": ' ~ (v | int)) -%}{%- endif -%}
