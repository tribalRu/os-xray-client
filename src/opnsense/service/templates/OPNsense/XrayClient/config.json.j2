{%- if kind == 'udp' and q | length > 0 -%}{%- do parts.append('"quicParams": { ' ~ (q | join(', ')) ~ ' }') -%}{%- endif -%}
{%- if parts | length > 0 -%}
{ {{ parts | join(', ') }} }
