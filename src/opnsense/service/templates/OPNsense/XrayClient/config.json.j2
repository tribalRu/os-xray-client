{%-   set v = node.fm_udp_udphop_remote_ips | default('') | string | trim -%}
{%-   if v != '' -%}{%- do s.append('"remoteIPs": [' ~ (fm_items(v) | trim) ~ ']') -%}{%- endif -%}
{%-   set v = node.fm_udp_udphop_remote_ports | default('') | string | trim -%}
{%-   if v != '' -%}{%- do s.append('"remotePorts": ' ~ ((v | replace(' ', ',')) | tojson)) -%}{%- endif -%}
{%-   do udp_masks.append('{"type": "udphop", "settings": { ' ~ (s | join(', ')) ~ ' } }') -%}
{%- elif udp == 'mkcp-legacy' -%}
{%-   set s = [] -%}
{%-   set v = node.fm_udp_mkcp_header | default('none') | string | trim -%}
{%-   if v != '' and v != 'none' -%}{%- do s.append('"header": ' ~ (v | tojson)) -%}{%- endif -%}
{%-   set v = node.fm_udp_mkcp_value | default('') | string | trim -%}
{%-   if v != '' -%}{%- do s.append('"value": ' ~ (v | tojson)) -%}{%- endif -%}
{%-   do udp_masks.append('{"type": "mkcp-legacy", "settings": { ' ~ (s | join(', ')) ~ ' } }') -%}
{%- elif udp == 'xicmp' -%}
