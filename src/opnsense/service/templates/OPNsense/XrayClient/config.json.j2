{% if not helpers.empty('OPNsense.XrayClient.general.config_mode') and OPNsense.XrayClient.general.config_mode == 'raw' %}
{{ OPNsense.XrayClient.general.raw_json | default('{}') }}
{% else %}
{% set general = OPNsense.XrayClient.general %}
{% set stats_port = general.stats_port | default('10085') %}
{
  "log": {
    "access": "/var/log/xray/access.log",
    "error": "/var/log/xray/error.log",
    "loglevel": {{ (general.loglevel or 'warning') | tojson }}
  },
  "stats": {},
  "api": {
    "tag": "api",
    "services": [
      "StatsService"
    ]
  },
  "policy": {
    "system": {
      "statsInboundUplink": true,
      "statsInboundDownlink": true,
      "statsOutboundUplink": true,
      "statsOutboundDownlink": true
    }
  },
  "inbounds": [
    {
      "tag": "api-in",
      "listen": "127.0.0.1",
      "port": {{ stats_port | int }},
      "protocol": "dokodemo-door",
      "settings": {
        "address": "127.0.0.1"
      }
    }
{% if general.enable_tun | default('1') == '1' %}
    ,{
      "tag": "tun-in",
      "port": 0,
      "protocol": "tun",
      "settings": {
        "name": {{ (general.tun_iface or 'tun_xray0') | tojson }},
        "mtu": {{ general.tun_mtu | default('1500') | int }},
        "gateway": [ {{ (general.tun_address or '10.255.0.1/30') | tojson }} ],
        "userLevel": 0
      },
      "sniffing": {
        "enabled": {{ 'true' if general.enable_sniffing | default('1') == '1' else 'false' }},
        "destOverride": [
          "http",
          "tls",
          "quic"
        ],
        "routeOnly": true
      }
    }
{% endif %}
{% if general.enable_socks | default('1') == '1' %}
    ,{
      "tag": "socks-in",
      "listen": {{ (general.socks_listen or '127.0.0.1') | tojson }},
      "port": {{ general.socks_port | default('10808') | int }},
      "protocol": "socks",
      "settings": {
        "auth": "noauth",
        "udp": true
      },
      "sniffing": {
        "enabled": {{ 'true' if general.enable_sniffing | default('1') == '1' else 'false' }},
        "destOverride": [
          "http",
          "tls",
          "quic"
        ],
        "routeOnly": true
      }
    }
{% endif %}
{% if general.enable_http | default('0') == '1' %}
    ,{
      "tag": "http-in",
      "listen": {{ (general.socks_listen or '127.0.0.1') | tojson }},
      "port": {{ general.http_port | default('10809') | int }},
      "protocol": "http",
      "sniffing": {
        "enabled": {{ 'true' if general.enable_sniffing | default('1') == '1' else 'false' }},
        "destOverride": [
          "http",
          "tls"
        ],
        "routeOnly": true
      }
    }
{% endif %}
  ],
  "outbounds": [
{% set active_nodes = [] %}
{% if not helpers.empty('OPNsense.XrayClient.nodes.node') %}
{%   for node in helpers.toList('OPNsense.XrayClient.nodes.node') %}
{%     if node.enabled == '1' %}
{%        do active_nodes.append(node) %}
{%     endif %}
{%   endfor %}
{% endif %}
{% for node in active_nodes %}
    {
      "tag": {{ ('proxy' if loop.first else 'node_' ~ node['@uuid']) | tojson }},
      "protocol": {{ (node.protocol or '') | tojson }},
      "settings": {
{% if node.protocol in ['vless', 'vmess'] %}
        "vnext": [
          {
            "address": {{ (node.address or '') | tojson }},
            "port": {{ node.port | int }},
            "users": [
              {
                "id": {{ (node.user_uuid or '') | tojson }},
{% if node.protocol == 'vless' %}
                "encryption": {{ (node.encryption or 'none') | tojson }},
                "flow": {{ ('' if node.flow == 'none' else (node.flow or '')) | tojson }}
{% else %}
                "alterId": 0,
                "security": "auto"
{% endif %}
              }
            ]
          }
        ]
{% elif node.protocol == 'trojan' %}
        "servers": [
          {
            "address": {{ (node.address or '') | tojson }},
            "port": {{ node.port | int }},
            "password": {{ (node.user_uuid or '') | tojson }}
          }
        ]
{% elif node.protocol == 'shadowsocks' %}
        "servers": [
          {
            "address": {{ (node.address or '') | tojson }},
            "port": {{ node.port | int }},
            "method": {{ ((node.ss_method or '') | replace('x2022-', '2022-')) | tojson }},
            "password": {{ (node.user_uuid or '') | tojson }}
          }
        ]
{% endif %}
      },
      "streamSettings": {
{% set _custom_raw = (node.custom_stream_json or '') | trim %}
{% set _custom = _custom_raw | replace('{', '', 1) | reverse | replace('}', '', 1) | reverse | trim if _custom_raw != '' else '' %}
{% if _custom != '' %}
        "network": {{ (node.network or 'tcp') | tojson }},
        "security": {{ (node.security or 'none') | tojson }},
        {{ _custom }}
{% else %}
        "network": {{ (node.network or 'tcp') | tojson }},
        "security": {{ (node.security or 'none') | tojson }}
{%   if node.security == 'tls' %}
        ,"tlsSettings": {
          "serverName": {{ (node.sni or '') | tojson }},
          "allowInsecure": {{ 'true' if node.allow_insecure == '1' else 'false' }},
          "fingerprint": {{ (node.fingerprint or 'chrome') | tojson }}
{%     if node.alpn %}
          ,"alpn": [
{%       set _alpn_list = node.alpn.split(',') if node.alpn is string else node.alpn %}
{%       for a in _alpn_list %}
            {{ (a | string | trim) | tojson }}{{ "," if not loop.last else "" }}
{%       endfor %}
          ]
{%     endif %}
        }
{%   elif node.security == 'reality' %}
        ,"realitySettings": {
          "show": false,
          "fingerprint": {{ (node.fingerprint or 'chrome') | tojson }},
          "serverName": {{ (node.sni or '') | tojson }},
          "publicKey": {{ (node.reality_pubkey or '') | tojson }},
          "shortId": {{ (node.reality_shortid or '') | tojson }},
          "spiderX": {{ (node.reality_spiderx or '/') | tojson }}
        }
{%   endif %}
{%   if node.network == 'ws' %}
        ,"wsSettings": {
          "path": {{ (node.transport_path or '/') | tojson }},
          "headers": {
            "Host": {{ (node.transport_host or '') | tojson }}
          }
        }
{%   elif node.network == 'grpc' %}
        ,"grpcSettings": {
          "serviceName": {{ (node.grpc_service_name or '') | tojson }},
          "multiMode": {{ 'true' if node.grpc_multi_mode == '1' else 'false' }}
        }
{%   elif node.network == 'xhttp' %}
        ,"xhttpSettings": {
          "host": {{ (node.transport_host or '') | tojson }},
          "path": {{ (node.transport_path or '/') | tojson }},
          "mode": {{ (node.xhttp_mode or 'auto') | tojson }}
        }
{%   elif node.network == 'httpupgrade' %}
        ,"httpupgradeSettings": {
          "host": {{ (node.transport_host or '') | tojson }},
          "path": {{ (node.transport_path or '/') | tojson }}
        }
{%   endif %}
{% endif %}
      },
      "mux": {
        "enabled": {{ 'true' if node.mux_enabled == '1' else 'false' }}
      }
    },
{% endfor %}
    {
      "tag": "direct",
      "protocol": "freedom",
      "settings": {}
    },
    {
      "tag": "block",
      "protocol": "blackhole",
      "settings": {}
    }
  ],
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "type": "field",
        "inboundTag": [
          "api-in"
        ],
        "outboundTag": "api"
      }
{% if not helpers.empty('OPNsense.XrayClient.rules.rule') %}
{%   for rule in helpers.toList('OPNsense.XrayClient.rules.rule', 'sequence', 'asc') %}
{%     if rule.enabled == '1' %}
      ,{
        "type": "field",
{%       if rule.domain %}
        "domain": [
{%         set _domain_list = rule.domain.split(',') if rule.domain is string else rule.domain %}
{%         for d in _domain_list %}
          {{ (d | string | trim) | tojson }}{{ "," if not loop.last else "" }}
{%         endfor %}
        ],
{%       endif %}
{%       if rule.ip %}
        "ip": [
{%         set _ip_list = rule.ip.split(',') if rule.ip is string else rule.ip %}
{%         for i in _ip_list %}
          {{ (i | string | trim) | tojson }}{{ "," if not loop.last else "" }}
{%         endfor %}
        ],
{%       endif %}
{%       if rule.port %}
        "port": {{ (rule.port | string | trim) | tojson }},
{%       endif %}
{%       if rule.protocol %}
        "protocol": [
{%         set _proto_list = rule.protocol.split(',') if rule.protocol is string else rule.protocol %}
{%         for p in _proto_list %}
          {{ (p | string | trim) | tojson }}{{ "," if not loop.last else "" }}
{%         endfor %}
        ],
{%       endif %}
        "network": {{ ('tcp,udp' if rule.network_proto == 'tcp_udp' else (rule.network_proto or 'tcp,udp')) | tojson }},
        "outboundTag": {{ (rule.outbound_tag or 'direct') | tojson }}
      }
{%     endif %}
{%   endfor %}
{% endif %}
      ,{
        "type": "field",
        "network": "tcp,udp",
        "outboundTag": "{{ 'proxy' if active_nodes | length > 0 else 'direct' }}"
      }
    ]
  }
}
{% endif %}
