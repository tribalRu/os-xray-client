{% macro selector_array(value, nodes) -%}
{#- Expand tag prefixes into explicit outbound tags, leaving out nodes that
    are not real egress paths (freedom, blackhole, dns, loopback): a balancer
    or observatory matching "node_" would otherwise rotate traffic into a
    blackhole. A prefix that matches no node is passed through unchanged, so
    balancers aimed at tags not generated here keep working. When the prefix
    does match nodes but none of them is a proxy, emit "__none__" instead:
    Xray rejects an empty selector list ("empty selector list") and the
    balancer then selects nothing, which fails closed. -#}
[
{%- set _skip = ['freedom', 'blackhole', 'dns', 'loopback'] -%}
{%- set _out = [] -%}
{%- for _p in (value.split(',') if value is string else (value or [])) -%}
{%-   set _pfx = _p | string | trim -%}
{%-   if _pfx != '' -%}
{%-     set _any = [] -%}
{%-     set _hit = [] -%}
{%-     for _n in nodes -%}
{%-       set _tag = 'node_' ~ _n['@uuid'] -%}
{%-       if _tag.startswith(_pfx) -%}
{%-         do _any.append(_tag) -%}
{%-         if (_n.protocol or '') not in _skip -%}
{%-           do _hit.append(_tag) -%}
{%-         endif -%}
{%-       endif -%}
{%-     endfor -%}
{%-     for _t in (_hit if _hit else (['__none__'] if _any else [_pfx])) -%}
{%-       if _t not in _out -%}{%- do _out.append(_t) -%}{%- endif -%}
{%-     endfor -%}
{%-   endif -%}
{%- endfor -%}
{%- for _t in _out -%}
{{ _t | tojson }}{{ "," if not loop.last else "" }}
{%- endfor -%}
]
{%- endmacro -%}
{% macro int_array(value, fallback) -%}
[
{%- set _vals = value.split(',') if value is string else (value or []) -%}
{%- if _vals -%}
{%- for v in _vals -%}
{{ (v | string | trim) | int }}{{ "," if not loop.last else "" }}
{%- endfor -%}
{%- else -%}
{{ fallback }}
{%- endif -%}
]
{%- endmacro -%}
{% macro header_object(value) -%}
{{ value | replace('{', '', 1) | reverse | replace('}', '', 1) | reverse | trim }}
{%- endmacro -%}
