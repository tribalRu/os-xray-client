{% if not helpers.empty('OPNsense.XrayClient.general.config_mode') and OPNsense.XrayClient.general.config_mode == 'raw' %}
{{ OPNsense.XrayClient.general.raw_json | default('{}') }}
{% else %}
{% set general = OPNsense.XrayClient.general %}
{% set stats_port = general.stats_port | default('10085') %}
{% macro json_array(value, fallback) -%}
[
{%- set _vals = value.split(',') if value is string else (value or []) -%}
{%- if _vals -%}
{%- for v in _vals -%}
{{ (v | string | trim) | tojson }}{{ "," if not loop.last else "" }}
{%- endfor -%}
{%- else -%}
{{ fallback }}
{%- endif -%}
]
{%- endmacro -%}
{#- FinalMask helpers: the dialog edits one mask per direction plus the QUIC
    tuning, and the raw "finalmask" value still wins when it is not empty.
    Int32Range values ("3-7" or "30") are emitted as strings because that is
    what the core's Int32Range parser accepts; lists take commas, semicolons
    or whitespace. -#}
{% macro fm_items(value) -%}
{%- set _s = value | string -%}
{%- set _s = _s.replace(';', ',') -%}
{%- set _s = _s.replace('\n', ',') -%}
{%- set _s = _s.replace('\r', ',') -%}
{%- set _s = _s.replace(' ', ',') -%}
{%- set _out = [] -%}
{%- for _v in _s.split(',') -%}
{%-   set _t = _v | trim -%}
{%-   if _t != '' -%}{%- do _out.append(_t | tojson) -%}{%- endif -%}
{%- endfor -%}
{{ _out | join(', ') }}
{%- endmacro %}
{% macro fm_sudoku(password, ascii, pmin, pmax, tables) -%}
{%- set s = [] -%}
{%- set v = password | string | trim -%}
{%- if v != '' -%}{%- do s.append('"password": ' ~ (v | tojson)) -%}{%- endif -%}
{%- set v = ascii | string | trim -%}
{%- if v != '' -%}{%- do s.append('"ascii": ' ~ (v | tojson)) -%}{%- endif -%}
{%- set v = pmin | string | trim -%}
{%- if v != '' -%}{%- do s.append('"paddingMin": ' ~ (v | int)) -%}{%- endif -%}
{%- set v = pmax | string | trim -%}
{%- if v != '' -%}{%- do s.append('"paddingMax": ' ~ (v | int)) -%}{%- endif -%}
{%- set v = tables | string | trim -%}
{%- if v != '' -%}{%- do s.append('"customTables": [' ~ (fm_items(v) | trim) ~ ']') -%}{%- endif -%}
{{ s | join(', ') }}
{%- endmacro %}
{#- kind is "tcp" or "udp": TCP masks apply to TCP-based transports, UDP masks
    and the QUIC parameters to QUIC-based ones (Hysteria, MASQUE over HTTP/3,
    XHTTP over h3). Rows saved for the other kind are left out, so a stale
    hidden value cannot leak into the config. -#}
