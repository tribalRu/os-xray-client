{% macro outbound_block(node, tag) -%}
{%   set proto = node.protocol or '' %}
    {
      "tag": {{ tag | tojson }},
      "protocol": {{ proto | tojson }},
      "targetStrategy": {{ (node.target_strategy or 'AsIs') | tojson }},
{%   if node.send_through %}
      "sendThrough": {{ node.send_through | tojson }},
{%   endif %}
{%   if proto == 'wireguard' %}
      "settings": {
        "secretKey": {{ (node.wg_secret_key or '') | tojson }},
        "address": {{ json_array(node.wg_address, '"10.0.0.1"') }},
        "peers": [
          {
            "endpoint": {{ (node.wg_endpoint or '') | tojson }},
            "publicKey": {{ (node.wg_public_key or '') | tojson }},
{%     if node.wg_preshared_key %}
            "preSharedKey": {{ node.wg_preshared_key | tojson }},
{%     endif %}
            "keepAlive": {{ (node.wg_keepalive or '0') | int }},
            "allowedIPs": {{ json_array(node.wg_allowed_ips, '"0.0.0.0/0", "::/0"') }}
          }
        ],
        "noKernelTun": {{ 'true' if node.wg_no_kernel_tun == '1' else 'false' }},
        "mtu": {{ (node.wg_mtu or '1420') | int }},
        "reserved": {{ int_array(node.wg_reserved, '0, 0, 0') }},
        "remoteDNS": {{ json_array(node.wg_remote_dns, '"1.1.1.1", "1.0.0.1"') }}
{%   elif proto in ['vless', 'vmess'] %}
      "settings": {
        "vnext": [
          {
            "address": {{ (node.address or '') | tojson }},
            "port": {{ node.port | int }},
            "users": [
              {
                "id": {{ (node.user_uuid or '') | tojson }},
{%     if proto == 'vless' %}
                "encryption": {{ (node.encryption or 'none') | tojson }}
{%       if node.email %}
                ,"email": {{ node.email | tojson }}
{%       endif %}
                ,"flow": {{ ('' if node.flow == 'none' else (node.flow or '')) | tojson }}
{%       if node.extra %}
                ,"extra": { {{ header_object(node.extra) }} }
{%       endif %}
{%     else %}
                "alterId": 0,
                "security": {{ (node.vmess_security or 'auto') | tojson }}
{%       if node.vmess_experiments %}
                ,"experiments": {{ node.vmess_experiments | tojson }}
{%       endif %}
{%     endif %}
              }
            ]
          }
        ]
{%   elif proto == 'trojan' %}
      "settings": {
        "servers": [
          {
            "address": {{ (node.address or '') | tojson }},
            "port": {{ node.port | int }},
            "password": {{ (node.user_uuid or '') | tojson }}
          }
        ]
{%   elif proto == 'shadowsocks' %}
      "settings": {
        "servers": [
          {
            "address": {{ (node.address or '') | tojson }},
            "port": {{ node.port | int }},
            "method": {{ ((node.ss_method or '') | replace('x2022-', '2022-')) | tojson }},
            "password": {{ (node.user_uuid or '') | tojson }}
          }
        ]
{%   elif proto in ['socks', 'http'] %}
      "settings": {
        "address": {{ (node.address or '') | tojson }},
        "port": {{ node.port | int }}
{%     if node.auth_user %}
        ,"user": {{ node.auth_user | tojson }}
{%     endif %}
{%     if node.auth_pass %}
        ,"pass": {{ node.auth_pass | tojson }}
{%     endif %}
{%     if proto == 'http' and node.http_headers %}
        ,"headers": { {{ header_object(node.http_headers) }} }
{%     endif %}
{%   elif proto == 'hysteria' %}
      "settings": {
        "version": 2,
        "address": {{ (node.address or '') | tojson }},
        "port": {{ node.port | int }}
{%   elif proto == 'masque' %}
      "settings": {
        "address": {{ (node.address or '') | tojson }},
        "port": {{ node.port | int }}
{%     if node.masque_mode != 'warp' %}
        ,"remoteDNS": {{ json_array(node.masque_remote_dns, '"1.1.1.1", "1.0.0.1"') }}
{%     endif %}
{%   elif proto == 'freedom' %}
      "settings": {
        "userLevel": 0
{%     if node.freedom_redirect %}
        ,"redirect": {{ node.freedom_redirect | tojson }}
{%     endif %}
{%     if node.freedom_proxy_protocol == 'v1' %}
        ,"proxyProtocol": 1
{%     elif node.freedom_proxy_protocol == 'v2' %}
        ,"proxyProtocol": 2
{%     endif %}
{%     set _fr = (node.freedom_final_rules or '') | trim %}
{%     if _fr != '' %}
        ,"finalRules": {{ _fr }}
{%     endif %}
{%   elif proto == 'blackhole' %}
      "settings": {
{%     if node.blackhole_response == 'http' %}
        "response": {
          "type": "http"
        }
{%     endif %}
{%   elif proto == 'dns' %}
      "settings": {
        "userLevel": 0
{%     if node.dns_rewrite_network in ['tcp', 'udp'] %}
        ,"rewriteNetwork": {{ node.dns_rewrite_network | tojson }}
{%     endif %}
{%     if node.dns_rewrite_address %}
        ,"rewriteAddress": {{ node.dns_rewrite_address | tojson }}
{%     endif %}
{%     if node.dns_rewrite_port %}
        ,"rewritePort": {{ node.dns_rewrite_port | int }}
{%     endif %}
{%     set _dr = (node.dns_rules_json or '') | trim %}
{%     if _dr != '' %}
        ,"rules": {{ _dr }}
{%     endif %}
{%   elif proto == 'loopback' %}
      "settings": {
        "inboundTag": {{ (node.loopback_inbound_tag or 'loopback-in') | tojson }}
{%   else %}
      "settings": {
{%   endif %}
{%   set stream_protos = ['vless', 'vmess', 'trojan', 'shadowsocks', 'socks', 'http'] %}
