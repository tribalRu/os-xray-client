{%     set _bal_tag = (balancer.tag or 'auto') | string | trim %}
{%     set _bal_selector = balancer.selector | string | trim %}
{%     set _bal_fallback = balancer.fallback_tag | string | trim %}
      {
        "tag": {{ _bal_tag | tojson }},
        "selector": {% if _bal_selector != '' %}{{ json_array(_bal_selector, '[]') }}{% else %}["node_"]{% endif %},
        "strategy": {
          "type": {{ (balancer.strategy or 'leastPing') | tojson }}
        }{% if _bal_fallback != '' %},
        "fallbackTag": {{ _bal_fallback | tojson }}{% endif %}
      }{{ "," if not loop.last else "" }}
{%   endfor %}
    ],
{% elif _balancers_json != '' %}
    "balancers": {{ _balancers_json }},
{% endif %}
    "rules": [
      {
        "type": "field",
        "inboundTag": [
          "api-in"
        ],
        "outboundTag": "api"
      }
{% if not helpers.empty('OPNsense.XrayClient.rules.rule') %}
{%   for rule in helpers.toList('OPNsense.XrayClient.rules.rule', 'sequence', 'int') %}
{%     if rule.enabled == '1' %}
      ,{
        "type": "field",
{%       if rule.domain %}
        "domain": [
{%         set _domain_list = rule.domain.split(',') if rule.domain is string else rule.domain %}
{%         for d in _domain_list %}
          {{ (d | string | trim) | tojson }}{{ "," if not loop.last else "" }}
{%         endfor %}
        ],
{%       endif %}
{%       if rule.ip %}
        "ip": [
{%         set _ip_list = rule.ip.split(',') if rule.ip is string else rule.ip %}
{%         for i in _ip_list %}
          {{ (i | string | trim) | tojson }}{{ "," if not loop.last else "" }}
{%         endfor %}
        ],
{%       endif %}
{%       if rule.inbound_tag %}
        "inboundTag": {{ json_array(rule.inbound_tag, '[]') }},
{%       endif %}
{%       if rule.source %}
        "source": {{ json_array(rule.source, '[]') }},
{%       endif %}
{%       if rule.source_port %}
        "sourcePort": {{ (rule.source_port | string | trim) | tojson }},
{%       endif %}
{%       if rule.user %}
        "user": {{ json_array(rule.user, '[]') }},
{%       endif %}
{%       if rule.rule_tag %}
        "ruleTag": {{ (rule.rule_tag | string | trim) | tojson }},
{%       endif %}
{%       if rule.port %}
        "port": {{ (rule.port | string | trim) | tojson }},
{%       endif %}
{%       if rule.protocol %}
        "protocol": [
{%         set _proto_list = rule.protocol.split(',') if rule.protocol is string else rule.protocol %}
{%         for p in _proto_list %}
          {{ (p | string | trim) | tojson }}{{ "," if not loop.last else "" }}
{%         endfor %}
        ],
{%       endif %}
        "network": {{ ('tcp,udp' if rule.network_proto == 'tcp_udp' else (rule.network_proto or 'tcp,udp')) | tojson }},
{%       set _target = (rule.outbound_tag or 'direct') | string | trim %}
{%       if _target in balancer_tags %}
        "balancerTag": {{ _target | tojson }}
{%       else %}
        "outboundTag": {{ _target | tojson }}
{%       endif %}
      }
{%     endif %}
{%   endfor %}
{% endif %}
      ,{
        "type": "field",
        "network": "tcp,udp",
        "outboundTag": "direct"
      }
    ]
  }
}
{% endif %}
