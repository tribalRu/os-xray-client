{%- set v = node.fm_quic_max_idle_timeout | default('') | string | trim -%}
{%- if v != '' -%}{%- do q.append('"maxIdleTimeout": ' ~ (v | int)) -%}{%- endif -%}
{%- set v = node.fm_quic_keep_alive_period | default('') | string | trim -%}
{%- if v != '' -%}{%- do q.append('"keepAlivePeriod": ' ~ (v | int)) -%}{%- endif -%}
{%- set v = node.fm_quic_max_incoming_streams | default('') | string | trim -%}
{%- if v != '' -%}{%- do q.append('"maxIncomingStreams": ' ~ (v | int)) -%}{%- endif -%}
{%- set v = node.fm_quic_init_stream_window | default('') | string | trim -%}
{%- if v != '' -%}{%- do q.append('"initStreamReceiveWindow": ' ~ (v | int)) -%}{%- endif -%}
