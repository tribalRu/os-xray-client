{%- elif udp in ['noise', 'xdns', 'header-custom'] -%}
{%-   set v = node.fm_udp_extra_json | default('') | string | trim -%}
{%-   if v != '' -%}
{%-     do udp_masks.append('{"type": ' ~ (udp | tojson) ~ ', "settings": { ' ~ (header_object(v) | trim) ~ ' } }') -%}
{%-   endif -%}
{%- endif -%}
{%- if kind == 'tcp' and tcp_masks | length > 0 -%}{%- do parts.append('"tcp": [' ~ (tcp_masks | join(', ')) ~ ']') -%}{%- endif -%}
{%- if kind == 'udp' and udp_masks | length > 0 -%}{%- do parts.append('"udp": [' ~ (udp_masks | join(', ')) ~ ']') -%}{%- endif -%}
{%- set q = [] -%}
{%- set v = node.fm_quic_congestion | default('auto') | string | trim -%}
{%- if v != '' and v != 'auto' -%}{%- do q.append('"congestion": ' ~ (v | tojson)) -%}{%- endif -%}
{%- set v = node.fm_quic_bbr_profile | default('auto') | string | trim -%}
{%- if v != '' and v != 'auto' -%}{%- do q.append('"bbrProfile": ' ~ (v | tojson)) -%}{%- endif -%}
{%- set v = node.fm_quic_brutal_up | default('') | string | trim -%}
{%- if v != '' -%}{%- do q.append('"brutalUp": ' ~ (v | tojson)) -%}{%- endif -%}
{%- set v = node.fm_quic_brutal_down | default('') | string | trim -%}
