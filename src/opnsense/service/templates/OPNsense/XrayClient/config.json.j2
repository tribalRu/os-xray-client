{%-   do udp_masks.append('{"type": "salamander", "settings": { ' ~ (s | join(', ')) ~ ' } }') -%}
{%- elif udp == 'sudoku' -%}
{%-   do udp_masks.append('{"type": "sudoku", "settings": { ' ~ (fm_sudoku(node.fm_udp_sudoku_password, node.fm_udp_sudoku_ascii, node.fm_udp_sudoku_padding_min, node.fm_udp_sudoku_padding_max, node.fm_udp_sudoku_tables) | trim) ~ ' } }') -%}
{%- elif udp == 'udphop' -%}
